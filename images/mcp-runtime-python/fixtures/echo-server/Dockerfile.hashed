# Hashed-requirements derivative. The wheel hash is produced in the build
# stage; the final image has no compiler, uv, or credentials.
ARG RUNTIME_BASE=gridctl-mcp-runtime-python:local
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.8.14@sha256:f3660c56d5b08d6c516360981bedc439f499b9bf37f46a216018da3777a74011

FROM ${UV_IMAGE} AS uv
FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS build
COPY --from=uv /uv /uvx /bin/
WORKDIR /src
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_NO_CACHE=1 UV_PYTHON_DOWNLOADS=0
COPY pyproject.toml README.md hash_install.py ./
COPY src ./src
RUN uv build --wheel -o /tmp/wheels \
    && uv venv /app/.venv --python python3.12 \
    && python3 hash_install.py /bin/uv

FROM ${RUNTIME_BASE}
USER 0
COPY --from=build /app/.venv /app/.venv
RUN chmod -R a+rX /app && chown -R root:root /app
USER 10001:10001
CMD ["mcp-echo-fixture"]
