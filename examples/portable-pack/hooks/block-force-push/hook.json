{
  "name": "block-force-push",
  "description": "Deny git push --force before it runs",
  "dialect": "claude-code",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/block-force-push.sh",
            "if": "Bash(git push *)"
          }
        ]
      }
    ]
  }
}
