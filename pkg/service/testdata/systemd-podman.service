# Generated by gridctl service install. Do not edit; re-run the command to change it.
[Unit]
Description=gridctl gateway for stack netops
Documentation=https://github.com/gridctl/gridctl/blob/main/docs/installation.md
After=podman.socket
Wants=podman.socket
StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
Type=simple
ExecStart=/usr/local/bin/gridctl apply /home/u/team/stack.yaml --foreground --quiet --port 8180 --base-port 9000
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
Environment=GRIDCTL_HOME=/home/u
Environment=PATH=/usr/bin:/bin
Environment=DOCKER_HOST=unix:///run/docker.sock

[Install]
WantedBy=default.target
