# Generated by gridctl service install. Do not edit; re-run the command to change it.
[Unit]
Description=gridctl gateway for stack my-stack
Documentation=https://github.com/gridctl/gridctl/blob/main/docs/installation.md
StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
Type=simple
ExecStart="/opt/grid ctl/bin/gridctl" apply "/home/u/my stacks/100%%/stack.yaml" --foreground --quiet --port 8180 --base-port 9000
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
Environment=GRIDCTL_HOME=/home/u
Environment=PATH=/usr/bin:/opt/100%%/bin

[Install]
WantedBy=default.target
